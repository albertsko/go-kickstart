amends "package://github.com/jdx/hk/releases/download/v2.8.1/hk@2.8.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.8.1/hk@2.8.1#/Builtins.pkl"

min_hk_version = "2.8.1"
exclude = "vendor"

steps {
  ["go-format"] {
    check = "golangci-lint fmt --diff"
    fix = "golangci-lint fmt"
  }
  ["shell-format"] = Builtins.shfmt
  ["markdown-format"] {
    glob = "**/*.md"
    check = "oxfmt --check {{files}}"
    fix = "oxfmt {{files}}"
  }
}

hooks {
  ["check"] {
    steps {
      ["go-project"] {
        glob = List("**/*.go", "go.mod", "go.sum", ".golangci.yml")
        check = "golangci-lint config verify && golangci-lint run && go mod tidy -diff && go fix -diff ./..."
        exclusive = true
      }
      ["shellcheck"] = Builtins.shellcheck
      ["jactionlint"] {
        check = "jactionlint"
      }
    }
  }
  ["pre-commit"] {
    enabled = false
  }
}
