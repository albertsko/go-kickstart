#!/usr/bin/env bash
set -euo pipefail

# Tasks are task_* functions, so they never shadow commands like `test`.

SCRIPT_DIR="$(dirname -- "$(realpath "${BASH_SOURCE[0]}")")"
readonly BREWFILE="ci/Brewfile"
# init renames this module once, and it never rewrites this file, so the value stays.
readonly TEMPLATE_MODULE="github.com/albertsko/go-kickstart"
cd "$SCRIPT_DIR" || exit 1

die() {
	printf 'Error: %s\n' "$1" >&2
	exit 1
}

_files() {
	git ls-files -z --cached --others --exclude-standard -- "$@" ':!vendor'
}

# _apply skips deleted files, and it runs nothing for an empty list.
_apply() {
	local files=()
	local f

	while IFS= read -r -d '' f; do
		[[ -e "$f" ]] || continue
		files+=("$f")
	done

	((${#files[@]} > 0)) || return 0
	"$@" "${files[@]}"
}

# _name_of skips a major version suffix like /v2.
_name_of() {
	local module="$1"
	local name="${module##*/}"

	if [[ "$name" =~ ^v[0-9]+$ ]]; then
		module="${module%/*}"
		name="${module##*/}"
	fi

	printf '%s\n' "$name"
}

_require_brew() {
	type -P brew >/dev/null 2>&1 || die "Homebrew is required; install it from https://brew.sh"
}

task_init() {
	local new_module="${1:-}"
	local old_module
	local old_name
	local new_name
	local parts=()

	[[ -n "$new_module" ]] || die "usage: ./run init <module path>, for example github.com/you/app"
	old_module="$(go list -m)"
	[[ "$old_module" == "$TEMPLATE_MODULE" ]] || die "init renames the template once, and this module is already $old_module"
	go mod edit -module "$new_module" -print >/dev/null || die "invalid module path: $new_module"

	old_name="$(_name_of "$old_module")"
	new_name="$(_name_of "$new_module")"

	# One pass, so a new name that contains the old name is not rewritten twice.
	# shellcheck disable=SC2016 # perl reads the values from the environment
	git grep -lIz -F -e "$old_module" -e "$old_name" -- . ':!run' |
		OLD_MODULE="$old_module" NEW_MODULE="$new_module" OLD_NAME="$old_name" NEW_NAME="$new_name" \
			xargs -0 perl -pi -e 's/(\Q$ENV{OLD_MODULE}\E)|\Q$ENV{OLD_NAME}\E/$1 ? $ENV{NEW_MODULE} : $ENV{NEW_NAME}/ge'

	[[ "$new_name" == "$old_name" ]] || git mv -- "cmd/$old_name" "cmd/$new_name"

	# The copyright holder is the owner in host/owner/name.
	IFS=/ read -r -a parts <<<"$new_module"
	if ((${#parts[@]} >= 3)); then
		OWNER="${parts[1]}" YEAR="$(date +%Y)" perl -pi -e 's/^Copyright \(c\) .*$/Copyright (c) $ENV{YEAR} $ENV{OWNER}/' LICENSE.md
	else
		printf 'Update the copyright holder in LICENSE.md.\n' >&2
	fi

	# The new names change table widths in markdown, so format before the first check.
	task_fmt

	printf 'Renamed %s to %s. Review with: git diff\n' "$old_module" "$new_module" >&2
}

task_deps() {
	_require_brew
	HOMEBREW_NO_AUTO_UPDATE=1 brew bundle check --file "$BREWFILE" || die "Homebrew dependency check failed"
}

task_brew() {
	_require_brew
	brew bundle --file "$BREWFILE" "$@" || die "Homebrew dependency installation failed"
}

task_fmt() {
	[[ $# -eq 0 || "$1" == "--check" ]] || die "usage: ./run fmt [--check]"

	if [[ "${1:-}" == "--check" ]]; then
		golangci-lint fmt --diff
		_files '*.sh' run | _apply shfmt -d
		_files '*.md' | _apply oxfmt --check
	else
		golangci-lint fmt
		_files '*.sh' run | _apply shfmt -w
		_files '*.md' | _apply oxfmt
	fi
}

task_lint() {
	golangci-lint run
	go mod tidy -diff
	go fix -diff ./...
	_files '*.sh' run | _apply shellcheck
	jactionlint
}

# shellcheck disable=SC2120 # extra args pass through to go test
task_test() {
	go test -race -shuffle=on ./... "$@"
}

task_build() {
	local name
	name="$(_name_of "$(go list -m)")"

	mkdir -p bin
	go build -trimpath -o "bin/$name" "./cmd/$name"
}

task_release_check() {
	goreleaser check
}

task_ci() {
	task_fmt --check
	task_lint
	task_test
	task_build
	task_release_check
}

task_clean() {
	rm -rf bin dist
	go clean -testcache
}

task_help() {
	printf 'Usage: ./run <task> [args]\n\nTasks:\n'
	printf '  %s\n' 'init <module>' deps brew fmt 'fmt --check' lint test build release-check ci clean
}

task="${1:-help}"
shift || true
[[ "$task" == "-h" || "$task" == "--help" ]] && task=help
# Task names use dashes, so release_check is not a second name for release-check.
[[ "$task" != *_* ]] || die "unknown task: $task"
declare -F -- "task_${task//-/_}" >/dev/null || die "unknown task: $task"
"task_${task//-/_}" "$@"
