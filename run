#!/usr/bin/env bash
set -euo pipefail

# Tasks are task_* functions, so they never shadow commands like `test`.

SCRIPT_DIR="$(dirname -- "$(realpath "${BASH_SOURCE[0]}")")"
readonly BREWFILE="ci/Brewfile"
cd "$SCRIPT_DIR" || exit 1

die() {
	printf 'Error: %s\n' "$1" >&2
	exit 1
}

_shell_files() {
	git ls-files --cached --others --exclude-standard -- '*.sh' ':!vendor'
	printf 'run\n'
}

_markdown_files() {
	git ls-files --cached --others --exclude-standard -- '*.md' ':!vendor'
}

_name() {
	local module
	module="$(go list -m)"
	printf '%s\n' "${module##*/}"
}

_require_brew() {
	type -P brew >/dev/null 2>&1 || die "Homebrew is required; install it from https://brew.sh"
}

task_init() {
	local new_module="${1:-}"
	local old_module

	[[ -n "$new_module" ]] || die "usage: ./run init <module path>, for example github.com/you/app"
	old_module="$(go list -m)"
	[[ "$new_module" != "$old_module" ]] || die "module is already $new_module"

	# One pass, so a new name that contains the old name is not rewritten twice.
	# shellcheck disable=SC2016 # perl reads the values from the environment
	git grep -lIz -F -e "$old_module" -e "${old_module##*/}" -- . |
		OLD_MODULE="$old_module" NEW_MODULE="$new_module" \
			OLD_NAME="${old_module##*/}" NEW_NAME="${new_module##*/}" \
			xargs -0 perl -pi -e 's/(\Q$ENV{OLD_MODULE}\E)|\Q$ENV{OLD_NAME}\E/$1 ? $ENV{NEW_MODULE} : $ENV{NEW_NAME}/ge'

	git mv -- "cmd/${old_module##*/}" "cmd/${new_module##*/}"

	printf 'Renamed %s to %s. Review with: git diff\n' "$old_module" "$new_module" >&2
}

task_deps() {
	_require_brew
	HOMEBREW_NO_AUTO_UPDATE=1 brew bundle check --file "$BREWFILE" || die "Homebrew dependency check failed"
}

task_brew() {
	_require_brew
	brew bundle --file "$BREWFILE" "$@" || die "Homebrew dependency installation failed"
}

task_fmt() {
	local sh_files=()
	local md_files=()
	local f

	while IFS= read -r f; do sh_files+=("$f"); done < <(_shell_files)
	while IFS= read -r f; do md_files+=("$f"); done < <(_markdown_files)

	if [[ "${1:-}" == "--check" ]]; then
		golangci-lint fmt --diff
		shfmt -d "${sh_files[@]}"
		oxfmt --check "${md_files[@]}"
	else
		golangci-lint fmt
		shfmt -w "${sh_files[@]}"
		oxfmt "${md_files[@]}"
	fi
}

task_lint() {
	local sh_files=()
	local f

	golangci-lint run
	go mod tidy -diff
	go fix -diff ./...

	while IFS= read -r f; do sh_files+=("$f"); done < <(_shell_files)
	shellcheck "${sh_files[@]}"

	jactionlint
}

# shellcheck disable=SC2120 # extra args pass through to go test
task_test() {
	go test -race -shuffle=on ./... "$@"
}

task_build() {
	local name
	name="$(_name)"

	mkdir -p bin
	go build -trimpath -o "bin/$name" "./cmd/$name"
}

task_release_check() {
	goreleaser check
}

task_ci() {
	task_fmt --check
	task_lint
	task_test
	task_build
	task_release_check
}

task_clean() {
	rm -rf bin dist
	go clean -testcache
}

task_help() {
	printf 'Usage: ./run <task> [args]\n\nTasks:\n'
	printf '  %s\n' 'init <module>' deps brew fmt 'fmt --check' lint test build release-check ci clean
}

task="${1:-help}"
shift || true
declare -F -- "task_${task//-/_}" >/dev/null || die "unknown task: $task"
"task_${task//-/_}" "$@"
